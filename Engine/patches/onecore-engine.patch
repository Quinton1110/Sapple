+        W[1][2] = W[1][2] / W[1][0];
+        for (t = 2; t < T; t++) {
+            W[t][0] = W[t][0] - W[t - 2][2] * W[t - 2][2] * W[t - 2][0];
+            W[t][0] = W[t][0] - W[t - 1][1] * W[t - 1][1] * W[t - 1][0];
+            W[t][1] = W[t][1] - W[t - 1][1] * W[t - 1][2] * W[t - 1][0];
