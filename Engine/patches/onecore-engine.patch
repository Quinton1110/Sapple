+        W[0][0] = (double)(f22 * P(1, ia)) + W[0][0];
+        W[0][1] = (double)(f20 * P(1, ia)) + W[0][1];
+        W[0][2] = (double)(dm * dp * P(1, id)) + W[0][2];
+        W[0][2] = (double)(am * ap * P(1, ia)) + W[0][2];
+        R[0] = (double)(dm * B(1, id)) + R[0];
+        R[0] = (double)(am * B(1, ia)) + R[0];
