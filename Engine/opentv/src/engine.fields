# Engine object layout (the C++ object the SAPI engine thread keeps on its
# stack; CGRM_EN sub_1002e240 frame at ebp-0x91bc).  Offsets are exact for
# the original 32-bit layout.  Generated into build/gen/engine_struct.h by
# tools/gen_struct.py.  Names are provisional until each field's use is
# fully understood.

# One queued input segment of a TextData item, split at line breaks
# (CGRM_EN sub_10055aa0).
struct InputSeg 0x10
0x00 char     *text
0x08 int16_t   len
0x0a uint8_t   caps_only        # no lower-case or high-bit characters
0x0b uint8_t   no_words         # nothing speakable (only punctuation/space)
0x0c uint8_t   flag_c
end

# One entry of the stage 0 rule call stack.
struct S0Frame 0x8
0x00 const uint8_t *ip
0x04 uint8_t   nactions
0x05 uint8_t   skip
end

# A node of the engine's work list.  Every pipeline stage transforms and
# re-labels nodes in place; the low three flag bits are the node type
# (0 = control command, 1..5 = stage-specific kinds, 6 = free, 7 = sentinel).
struct Node 0x20
0x00 Node     *next
0x04 Node     *prev
0x08 uint32_t  flags            # bits 0-2 type, bits 3-7 per-stage flags
0x0c uint32_t  arg              # control nodes: command argument
0x10 uint32_t  d10
0x14 uint8_t   b14
0x15 uint8_t   b15
0x16 uint8_t   value            # character / command letter
0x17 uint8_t   syllable         # 1-based syllable number within the word
0x18 uint8_t   b18
0x19 uint8_t   b19
0x1a uint8_t   b1a              # the output mode in force when stage 2 passed
0x1c uint32_t  notify           # 'i' (index mark) commands: TextData notify context
end

# Per-stage cursor into the work list plus the voice parameters in effect at
# that stage's position (control nodes update them as the stage passes).
# Five of these follow at Engine+0x2144, one per pipeline stage.
struct StageCtx 0x44
0x00 Node     *first            # start of this stage's window
0x04 Node     *cur              # nodes before cur are done by this stage
0x08 Node     *ctl              # next control node to execute
0x0c Node     *scan
0x10 Node     *last             # end of this stage's window
0x14 Node     *d14              # start of the text the stage is matching
0x18 Node     *d18              # scratch cursor
0x1c int32_t   p_1c
0x20 int32_t   p_20
0x24 int32_t   rate_index       # (wpm - 46) >> 3
0x28 int32_t   pitch
0x2c int32_t   volume_atten     # 0..15
0x30 int32_t   p_30
0x34 int32_t   p_34
0x38 int32_t   p_38
0x3c uint32_t  type_mask        # node types this stage processes (bit per type)
0x40 int32_t   voice
end

# The per-parameter transition state stage 3 keeps while it writes a phoneme.
struct S3Param 0x1c
0x00 int32_t  mode             # how the parameter travels (see Stage3_Write)
0x04 int32_t  shape_in         # the curve it blends back along
0x08 int32_t  shape_out        # the curve it decays along, or a ramp length
0x0c int32_t  len              # frames this parameter advances this step
0x10 int32_t  lead             # the value blended into the frames before
0x14 int32_t  start            # where the phoneme's own run starts
0x18 int32_t  target           # and where it settles
end

struct Engine 0x9184
0x0000 uint8_t  synth_busy
0x0004 int32_t  trk_04
0x0008 int32_t  trk_08
0x000c int32_t  trk_0c
0x0010 int32_t  trk_10
0x0014 uint8_t  trk_14[32]
0x0034 int32_t  trk_34
0x0038 int32_t  trk_38
0x003c int32_t  trk_wr[22]       # per-parameter track write position
0x0094 int32_t  trk_rd[22]       # per-parameter track read position
0x00ec uint8_t *trk_buf[22]      # -> trk_data[i]
0x0144 S3Param  s3_param[22]     # per-parameter transition state
0x03ac uint8_t  trk_data[22][256] # 22 synthesis-parameter tracks
0x19ac uint8_t  synth_hold       # ESC[H / ESC[C
0x19ad uint8_t  synth_19ad
0x19ae uint8_t  synth_19ae
0x19b0 int16_t  filt_coef[40]    # Q15 coefficients, sample-rate dependent
0x1a00 int32_t  mode_I           # ESC[..I (0/1)
0x1a04 int32_t  mode_P           # ESC[..P (0/1)
0x1a08 int32_t  rate_index       # (speed_wpm - 46) >> 3
0x1a0c int32_t  speed_wpm
0x1a10 int32_t  pitch
0x1a14 int32_t  volume_atten     # 0..15, from log10 of the SAPI volume
0x1a18 int32_t  rate_class       # ESC[..f (0..9): caps rate_index
0x1a1c int32_t  flags_N          # ESC[..N / ESC[..F bits
0x1a20 int32_t  flags_A          # ESC[..A / ESC[..D bits
0x1a24 int32_t  voice            # 0..9
0x1a28 uint8_t  cfg_bytes[22]    # ESC[k;v l: raw synthesis parameter defaults
0x1a40 InputSeg in_seg[10]
0x1ae0 uint32_t feed_pos         # position within the current TextData item
0x1ae4 int32_t  e_1ae4
0x1ae8 int32_t  in_flags_N       # flags_N as seen by the input stage
0x1aec int32_t  in_flags_A       # flags_A as seen by the input stage
