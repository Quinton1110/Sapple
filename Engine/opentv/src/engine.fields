# A token of the TextIn front end (malloc'd, 0x3c bytes).  `bits` is a
# 96-bit class set stored most-significant word first: class k lives in
# bits[2 - k/32] (see Bits_Test).
struct Token 0x3c
0x00 Token    *prev
0x04 Token    *next
0x08 int16_t   w08
0x0a int16_t   w0a
0x0c uint32_t  bits[3]
0x18 void     *d18
0x1c uint32_t  d1c
0x20 char     *text
0x24 int16_t   len
0x28 char     *text2            # replacement text emitted instead of `text`
0x2c char     *types            # per-char split marks: 1 plain, 2 split before, 3 split after
0x30 uint8_t   trail            # character that ended the token (emitted after it)
0x34 int16_t   w34
0x36 int16_t   is_number
0x38 int32_t   num              # value of an all-digit token
end

# The TextIn front end (operator new'd, 0x70 bytes): tokenizes the raw input
# ring, classifies and expands tokens, and feeds their text on to the
# preformatter.
struct TextIn 0x70
0x00 Engine   *engine
0x04 int32_t   d04
0x08 int32_t   input_done       # engine input ring ran dry
0x0c int32_t   item_done        # current TextData item fully fed
0x10 int32_t   mode
0x18 int32_t   d18
0x1c Token    *head
0x20 Token    *tail
0x24 Token    *cur              # tokens up to here are expanded
0x28 int32_t   count
0x32 int16_t   in_quote         # mode 4: inside a quoted block
0x34 int16_t   quote_len        # length of the detected quote prefix
0x36 int16_t   quote_count      # consecutive quoted lines seen
0x38 char      quote_prefix[12]
0x44 int32_t   err[10]
0x6c int32_t   nerr
end

# The SAPI "central" object that owns the engine thread.  Only the fields the
# engine itself touches are described; it exists only when the engine runs
# behind the SAPI layer (the portable build leaves Engine.sapi NULL).
struct SapiCentral 0xc10
0x0064 int32_t  voice
0x0068 uint8_t  mode_info[0xaf0]
0x0b60 void    *audio_queue
0x0b6c uint8_t  audio_lock[24]    # CRITICAL_SECTION
0x0b90 int16_t  pitch
0x0b94 int32_t  speed
0x0b9c int32_t  volume
0x0bac int32_t  ctx
0x0be0 void    *hwnd
end
