0x1c20 int32_t  s1_1c20
0x1c24 uint32_t  s1_rule         # the suffix rule that matched, a tv_ref
0x1c28 uint8_t  s1_1c28
0x1c29 uint8_t  s1_1c29
0x1c2a uint8_t  s1_1c2a           # word was preceded by '~'
0x1c2b uint8_t  s1_1c2b           # word was preceded by '`'
0x1c2c uint8_t  s1_1c2c
