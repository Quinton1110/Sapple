0x1b3c uint8_t  s0_need_test     # next step evaluates a condition
0x1b3d uint8_t  s0_1b3d
0x1b40 const uint8_t *s0_word_data  # replacement text after a matched word
0x1b44 uint8_t  s0_nactions      # actions left in the current rule
